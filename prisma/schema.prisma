// Rift — Prisma schema
// Docs: https://pris.ly/d/prisma-schema
// MVP with auth: User, Session, Account, Verification, Project, Complaint, Opportunity, SavedOpportunity.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String?
  emailVerified      Boolean            @default(false)
  image              String?
  // M25/M28 — billing plan. "free" | "pro". Only the Stripe webhook may write
  // plan/stripeSubscriptionId/planUpdatedAt after checkout; admins from
  // RIFT_ADMIN_EMAILS resolve to pro limits without a plan change.
  plan                 String    @default("free")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  planUpdatedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           Session[]
  accounts           Account[]
  projects           Project[]
  complaints         Complaint[]
  opportunities      Opportunity[]
  savedOpportunities SavedOpportunity[]
  validationWorkspaces ValidationWorkspace[]
  complaintImports   ComplaintImport[]
  aiRuns             AIRun[]
  productEvents      ProductEvent[]
  betaFeedback       BetaFeedback[]
  shareLinks         ShareLink[]
}

// M16A — Multi-Project Market Tests. Lets a user split market tests into
// separate projects so complaints, generated ideas, saved ideas, and Start
// Fresh behaviour do not mix. Every project belongs to exactly one user.
// M16B2 — archivedAt marks a project as archived (hidden from the normal
// selector, all data preserved). Null = active.
model Project {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  archivedAt         DateTime?
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaints         Complaint[]
  opportunities      Opportunity[]
  savedOpportunities SavedOpportunity[]
  validationWorkspaces ValidationWorkspace[]
  complaintImports   ComplaintImport[]
  aiRuns             AIRun[]
  productEvents      ProductEvent[]
  betaFeedback       BetaFeedback[]
  shareLinks         ShareLink[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId])
}

// M29 — Public share links for project and idea reports. token is 32 hex
// chars from crypto.randomBytes(16). kind: "project" | "idea". revokedAt null
// = live; a revoked or cascade-deleted link must 404, never dangle publicly —
// hence Cascade (not SetNull) on every relation. M16B3's manual delete
// transaction also clears these explicitly.
model ShareLink {
  id            String       @id @default(cuid())
  token         String       @unique
  kind          String
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@index([projectId])
  @@index([opportunityId])
}

model Session {
  id           String   @id @default(cuid())
  expiresAt   DateTime
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                    String   @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Complaint {
  id            String   @id @default(cuid())
  title         String
  body          String
  sourceDate    DateTime?
  // M31a — receipt: original post/page URL, finder-sourced complaints only.
  // sourceKind is the machine key ("reddit" | "appstore" | "hackernews" |
  // "web"); display labels live in lib/complaint-sources.ts.
  sourceUrl     String?
  sourceKind    String?
  sentiment     Float? // -1.0 (negative) .. 1.0 (positive)
  severity      Float? // 0.0 .. 100.0 estimated severity
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  opportunityId String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // M16D — optional link back to the import that created this complaint.
  complaintImportId String?
  complaintImport   ComplaintImport? @relation(fields: [complaintImportId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([opportunityId])
  @@index([userId])
  @@index([projectId])
  @@index([complaintImportId])
}

model Opportunity {
  id                 String   @id @default(cuid())
  title              String   // generated problem title
  summary            String   // summarised problem
  industry           String
  keywords           String[]
  opportunityScore   Int      // 0..100
  scoreBreakdown     Json     // explanation of how the score was calculated
  mentions           Int      // number of complaints in this cluster
  growth             Float    // growth trend inside the uploaded dataset
  competition        String   // "Low" | "Medium" | "High"
  sentiment          Float?   // average sentiment of cluster (-1..1)
  severity           Float?   // average severity of cluster (1..10, from Gemini)
  confidence         Int?     // Gemini confidence in the cluster (0..100)
  reason             String?  // Gemini reasoning / explanation for the cluster
  suggestedSoftware  String   // suggested software opportunity (kept for backwards compat)
  // M9 — complaint-grounded market-gap hypothesis (all optional so existing
  // rows render without crashing). UI prefers productAngle when present and
  // falls back to suggestedSoftware.
  marketGap                String?
  targetCustomer           String?
  likelyCurrentWorkarounds String?
  whyWorkaroundsFallShort  String?
  productAngle             String?
  differentiationAngle     String?
  validationQuestions      String[] @default([])
  riskFlags                String[] @default([])
  trend              Json     // [{ date, count }] for the trend chart
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // M16D — optional link back to the AI run that generated this idea.
  aiRunId            String?
  aiRun              AIRun?    @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  complaints        Complaint[]
  savedOpportunities SavedOpportunity[]
  validationWorkspaces ValidationWorkspace[]
  productEvents     ProductEvent[]
  shareLinks        ShareLink[]

  @@index([userId])
  @@index([projectId])
  @@index([aiRunId])
}

// M20 — Private beta access control. One row per normalized (lowercase)
// email; admins from RIFT_ADMIN_EMAILS never need a row. Only consulted when
// RIFT_BETA_MODE=invite_only. status: "invited" | "active" | "revoked".
model BetaAccess {
  id              String    @id @default(cuid())
  email           String    @unique
  status          String
  invitedByUserId String?
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  @@index([status])
}

// M20 — In-app beta feedback. Message text is only what the user typed into
// the feedback box — complaint text is never attached automatically.
// type: "bug" | "confusing" | "idea" | "praise" | "other".
model BetaFeedback {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  opportunityId String?
  type          String
  rating        Int?
  message       String
  pagePath      String?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}

// M19 — First-party product events for private beta insights. Metadata and
// counts only: NEVER complaint text, exported report contents, AI prompts, or
// raw AI output. Optional project/opportunity links use SetNull so deleting a
// project keeps the usage record without the reference.
model ProductEvent {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type          String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// M16D — Import/upload history. One row per successful complaint import
// (CSV, pasted text, demo data, starter pack, complaint finder). Records what
// data was added, from where, and when. Cascade-deleted with the user or the
// project (M16B3 permanent delete also removes these explicitly).
model ComplaintImport {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceType     String      // "csv" | "paste" | "demo" | "starter_market" | "finder"
  label          String
  complaintCount Int
  createdAt      DateTime    @default(now())
  complaints     Complaint[]
  aiRuns         AIRun[]

  @@index([userId, projectId])
  @@index([projectId])
}

// M16D — AI run history. One row per "Find ideas" pipeline run, recording the
// input complaint count, how many ideas came out, and whether it failed.
// status: "running" | "completed" | "failed".
model AIRun {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  complaintImportId      String?
  complaintImport        ComplaintImport? @relation(fields: [complaintImportId], references: [id], onDelete: SetNull)
  inputComplaintCount    Int
  outputOpportunityCount Int       @default(0)
  status                 String
  errorMessage           String?
  createdAt              DateTime  @default(now())
  completedAt            DateTime?
  opportunities          Opportunity[]

  @@index([userId, projectId])
  @@index([projectId])
}

// M16C — Database-backed Validation Workspace state. One row per user per
// opportunity. Replaces the old localStorage-only checklist/decision storage
// so progress survives refreshes, browsers, and devices.
// - decisionStatus: "undecided" | "pursue" | "park" | "reject"
// - validationChecklist: boolean[] mirroring VALIDATION_CHECKLIST_ITEMS
// - validationEvidence: reserved (the evidence-log UI was removed in an
//   earlier UX patch; kept nullable so no future migration is needed)
// Cascades: deleting the user, the project, or the opportunity removes the
// workspace row — so M16B3 permanent project delete cleans this up for free.
model ValidationWorkspace {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  decisionStatus      String      @default("undecided")
  validationChecklist Json?
  validationEvidence  Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([userId, opportunityId]) // one workspace per user per opportunity
  @@index([userId, projectId])
  @@index([projectId])
  @@index([opportunityId])
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note          String?
  createdAt      DateTime    @default(now())

  @@unique([userId, opportunityId]) // one save per user per opportunity
  @@index([projectId])
}
