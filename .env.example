# ----------------------------------------------------------------------------
# Rift — environment variables (example values only)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (example):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rift?schema=public"
# Neon Postgres (production). Prefer the POOLED connection string from the
# Neon dashboard — it ends in `-pooler` and uses port 5432 by default.
# Always include ?sslmode=require for Neon:
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Google Gemini API key (server-only). Used for AI clustering + summarisation.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Better Auth — secret used to sign tokens and hash passwords.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Better Auth — base URL of the app (no trailing slash).
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Browser auth client origin. Optional: set to the deployed origin on Vercel;
# leave unset locally to use the same-origin /api/auth default.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# M19 — Admin allowlist for the private /dashboard/beta-insights page.
# Comma-separated, case-insensitive. Leave empty to disable the page entirely.
# M20 — admins also always bypass the private beta gate.
RIFT_ADMIN_EMAILS="you@example.com"

# M20 — Private beta gate. "off" (or unset) = everyone signed-in can use the
# dashboard as before. "invite_only" = only admins and emails added under
# Beta insights → Beta access can enter; others are sent to /beta-access.
RIFT_BETA_MODE="off"

# M22 — Reddit API for the complaint finder (server-only). Optional. Without
# these, the Reddit source is disabled with a friendly note; the old public
# endpoint fallback was removed because Reddit often blocks it.
# Setup (~2 minutes):
#   1. Sign in to Reddit, go to https://www.reddit.com/prefs/apps
#   2. Click "create another app...", choose type "script".
#      Name: rift-app. Redirect URI: http://localhost:3000 (required, unused).
#   3. Client ID = the short string under the app name ("personal use script").
#      Client secret = the value labelled "secret".
REDDIT_CLIENT_ID="your_reddit_client_id_here"
REDDIT_CLIENT_SECRET="your_reddit_client_secret_here"

# M22 — Optional. Reddit asks for a unique descriptive User-Agent in the form
# "<platform>:<app-id>:<version> (by /u/<your-reddit-username>)".
# Falls back to a generic rift-app User-Agent when unset.
REDDIT_USER_AGENT="web:rift-app:v0.1 (by /u/your_reddit_username)"

# M30 — Tavily search API for the complaint finder's whole-web source
# (server-only). Without it, the web source shows a friendly "not configured"
# note and the other sources still work.
# Setup (~2 minutes): sign up at https://app.tavily.com (free tier ~1,000
# searches/month), copy the API key.
TAVILY_API_KEY="your_tavily_api_key_here"

# M27 — Resend for transactional email (password reset). Server-only,
# key-gated: without it the app works and the "Forgot password?" link is
# hidden. Setup (~2 minutes):
#   1. Sign up at https://resend.com (free tier: 100 emails/day).
#   2. Dashboard -> API Keys -> Create API Key (Full access) -> copy it.
RESEND_API_KEY="your_resend_api_key_here"

# M27 — Optional sender address. Leave unset to use Resend's shared
# onboarding sender (works before any domain is verified). After verifying
# your domain in Resend (Domains -> Add domain -> add the DNS records),
# switch to something like:  Rift <hello@yourdomain.com>
EMAIL_FROM="Rift <onboarding@resend.dev>"

# M28 — Stripe billing. Server-only, key-gated: without the secret key, price
# id, and webhook secret, the pricing page shows "payments coming soon" and no
# billing code runs. Start in TEST mode (toggle top-right in the dashboard).
# Setup:
#   1. https://dashboard.stripe.com -> Developers -> API keys -> copy the
#      Secret key (starts sk_test_ in test mode).
#   2. Product catalog -> Add product: "Rift Pro", $9.00 USD, Recurring
#      monthly -> save -> copy the price id (starts price_).
#   3. After deploying: Developers -> Webhooks -> Add endpoint
#      https://YOUR-DOMAIN/api/stripe/webhook with events
#      checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted, customer.subscription.paused,
#      customer.subscription.resumed, invoice.payment_failed -> copy the
#      Signing secret (whsec_).
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret_here"
STRIPE_PRICE_PRO_MONTHLY="price_your_pro_monthly_price_id_here"

# Post-M31 — YouTube comments source for the complaint finder (server-only).
# Optional, key-gated: without it the YouTube source quietly sits out and the
# other sources still work. Free key (~3 minutes, same Google account as
# GEMINI_API_KEY):
#   1. Go to https://console.cloud.google.com -> APIs & Services -> Library,
#      search "YouTube Data API v3" -> Enable.
#   2. APIs & Services -> Credentials -> Create credentials -> API key.
# Free quota is 10,000 units/day; one finder search uses ~105.
# Stack Exchange and GitHub sources need NO key at all.
YOUTUBE_API_KEY="your_youtube_api_key_here"

# M31c — Protects the weekly niche-watch cron route (/api/cron/niche-watch).
# Generate with: openssl rand -hex 32
# Add the SAME value in Vercel -> Settings -> Environment Variables; Vercel
# automatically sends it as a Bearer token when its cron (vercel.json) calls
# the route. Without it the route answers 503 and watches never run.
CRON_SECRET="replace-with-a-long-random-secret"
