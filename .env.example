# ----------------------------------------------------------------------------
# Rift — environment variables (example values only)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (example):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rift?schema=public"
# Neon Postgres (production). Prefer the POOLED connection string from the
# Neon dashboard — it ends in `-pooler` and uses port 5432 by default.
# Always include ?sslmode=require for Neon:
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Google Gemini API key (server-only). Used for AI clustering + summarisation.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Better Auth — secret used to sign tokens and hash passwords.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Better Auth — base URL of the app (no trailing slash).
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# M19 — Admin allowlist for the private /dashboard/beta-insights page.
# Comma-separated, case-insensitive. Leave empty to disable the page entirely.
# M20 — admins also always bypass the private beta gate.
RIFT_ADMIN_EMAILS="you@example.com"

# M20 — Private beta gate. "off" (or unset) = everyone signed-in can use the
# dashboard as before. "invite_only" = only admins and emails added under
# Beta insights → Beta access can enter; others are sent to /beta-access.
RIFT_BETA_MODE="off"
